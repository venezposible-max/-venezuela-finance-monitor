{
  "manifest_version": 3,
  "name": "Monitor Divisas Mercantil",
  "version": "1.0",
  "description": "Revisa automáticamente operaciones de intervención cambiaria en Banco Mercantil.",
  "permissions": [
    "storage",
    "notifications",
    "offscreen",
    "debugger"
  ],
  "host_permissions": [
    "https://*.mercantilbanco.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.mercantilbanco.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
